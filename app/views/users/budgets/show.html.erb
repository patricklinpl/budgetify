<% content_for :title, @budget.name %>

<% content_for :shell_header do %>
  <% if @selected_account %>
    <%= render "layouts/app_shell/register_header", account: @selected_account %>
  <% else %>
    <%= render "layouts/app_shell/plan_header" %>
  <% end %>
<% end %>

<% unless @selected_account %>
  <% content_for :shell_inspector do %>
    <%= render "layouts/app_shell/inspector_panels" %>
  <% end %>
<% end %>

<% if @grid %>
<% fmt = @budget.currency_format %>
<section class="budget-grid" aria-label="Budget for <%= Date.current.strftime("%B %Y") %>">
  <% if notice %><p class="plan-settings__notice" role="status"><%= notice %></p><% end %>
  <p>
    <% if @show_hidden %>
      <%= link_to "Hide hidden categories", users_budget_path(@budget.public_id), class: "budget-back-link" %>
    <% elsif @hidden_count.positive? %>
      <%= link_to "Show #{@hidden_count} hidden #{'category'.pluralize(@hidden_count)}", users_budget_path(@budget.public_id, hidden: 1), class: "budget-back-link" %>
    <% end %>
  </p>
  <% if @grid.empty? %>
    <p>This plan has no categories yet.</p>
  <% else %>
  <div class="data-table-wrap" data-controller="data-table">
    <table class="data-table" aria-label="Budget grid">
      <thead>
        <tr>
          <th>Category</th>
          <th class="data-table__money">Assigned</th>
          <th class="data-table__money">Activity</th>
          <th class="data-table__money">Available</th>
        </tr>
      </thead>
      <tbody>
        <% @grid.each do |entry| %>
          <% group = entry[:group] %>
          <tr class="data-table__group" data-group-id="<%= group.public_id %>">
            <td class="budget-grid__name"><button type="button" class="data-table__chevron" aria-expanded="true" aria-label="Toggle group <%= group.name %>" data-action="data-table#toggleGroup"></button> <%= group.name %><%= " (hidden)" if group.hidden %></td>
            <td class="data-table__money" data-label="Assigned"><%= grid_money(fmt, entry[:assigned]) %></td>
            <td class="data-table__money" data-label="Activity"><%= grid_money(fmt, entry[:activity]) %></td>
            <td class="data-table__money" data-label="Available"><%= grid_money(fmt, entry[:available]) %></td>
          </tr>
          <% entry[:rows].each do |row| %>
            <% category = row[:category] %>
            <% pill = row[:available].negative? ? :negative : (row[:available].zero? ? :zero : :positive) %>
            <tr class="data-table__row" data-group="<%= group.public_id %>">
              <td class="budget-grid__name">
                <%= category.name %><%= " (hidden)" if category.hidden %>
                <%= link_to "Edit", edit_users_budget_category_path(@budget.public_id, category.public_id), class: "budget-back-link", "aria-label": "Edit category #{category.name}" %>
              </td>
              <td class="data-table__money" data-label="Assigned">
                <% err = @assign_error if @assign_error && @assign_error[:id] == category.public_id %>
                <% input_id = "assigned_#{category.public_id}" %>
                <%= form_with url: assign_users_budget_category_path(@budget.public_id, category.public_id), method: :patch, scope: :assigned, data: { controller: "submit", action: "field:commit->submit#submit turbo:submit-end->submit#end" } do %>
                  <div class="field<%= ' field--invalid' if err %>" data-controller="field" data-field-kind-value="currency" data-field-defer-value="true">
                    <label class="data-table__sr" for="<%= input_id %>">Assigned for <%= category.name %></label>
                    <input class="field__input field__input--money" id="<%= input_id %>" name="assigned[amount]" value="<%= err ? err[:text] : format("%.#{(row[:assigned] % 10).zero? ? 2 : 3}f", row[:assigned] / 1000.0) %>" inputmode="decimal" autocomplete="off" aria-describedby="<%= input_id %>-err"<%= raw(' aria-invalid="true" autofocus') if err %> data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing">
                    <span class="field__error" id="<%= input_id %>-err" data-field-target="error" role="alert"<%= ' hidden' unless err %>><%= err[:message] if err %></span>
                    <span class="field__status data-table__sr" data-field-target="status" aria-live="polite"></span>
                  </div>
                  <button type="submit" class="btn btn--secondary" aria-label="Set assigned for <%= category.name %>">Set</button>
                <% end %>
              </td>
              <td class="data-table__money" data-label="Activity"><%= grid_money(fmt, row[:activity]) %></td>
              <td class="data-table__money" data-label="Available"><%= status_pill(pill, row[:available], text: grid_money(fmt, row[:available])) %>
                <% if row[:available].negative? && row[:category].payment_account_id.nil? %>
                  <%= link_to "Cover", cover_users_budget_category_path(@budget.public_id, row[:category].public_id), class: "budget-back-link", "aria-label": "Cover overspending for #{row[:category].name}" %>
                <% end %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</section>
<% end %>

<section class="shell-card">
  <% if notice %><p class="plan-settings__notice" role="status"><%= notice %></p><% end %>
  <p class="shell-eyebrow">Budget owner</p>
  <p>This budget belongs to <strong><%= Current.user.email_address %></strong>.</p>
  <p>
    <%= link_to "Choose another budget", users_budgets_path, class: "budget-back-link" %>
    &middot; <%= link_to "Plan settings", settings_users_budget_path(@budget.public_id), class: "budget-back-link" %>
  </p>
</section>
