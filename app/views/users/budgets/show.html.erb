<% content_for :title, @budget.name %>

<% content_for :shell_header do %>
  <% if @selected_account %>
    <%= render "layouts/app_shell/register_header", account: @selected_account %>
  <% else %>
    <%= render "layouts/app_shell/plan_header" %>
  <% end %>
<% end %>

<% unless @selected_account %>
  <% content_for :shell_inspector do %>
    <%= render "layouts/app_shell/inspector_panels" %>
  <% end %>
<% end %>

<section class="shell-card">
  <p class="shell-eyebrow">Budget owner</p>
  <p>This budget belongs to <strong><%= Current.user.email_address %></strong>.</p>
  <p><%= link_to "Choose another budget", users_budgets_path, class: "budget-back-link" %></p>
</section>
