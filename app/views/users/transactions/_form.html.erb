<%# Ordinary transaction editor: date, payee, category, memo, one of outflow or
    inflow. Money fields use the shared field controller (#70): client commit,
    adjacent error, aria-invalid, and submit disabled while invalid. %>
<% url = transaction ? users_budget_account_transaction_path(@budget.public_id, @account.public_id, transaction.public_id) : users_budget_account_transactions_path(@budget.public_id, @account.public_id) %>
<% if @errors.any? || @field_errors.any? %>
  <div class="plan-settings__errors" role="alert" tabindex="-1" data-controller="focus">
    <% @errors.each do |message| %><p><%= message %></p><% end %>
    <p>Nothing was changed.</p>
  </div>
<% end %>
<%= form_with url: url, method: (transaction ? :patch : :post), scope: :transaction, class: "plan-settings__form",
      data: { controller: "form submit", action: "input->form#update field:commit->form#update field:invalid->form#update field:cancel->form#update field:restored->form#update turbo:submit-end->submit#end" } do %>
  <div class="field">
    <label class="field__label" for="transaction_date">Date</label>
    <input class="field__input" type="date" id="transaction_date" name="transaction[date]" value="<%= @form[:date] %>" required>
  </div>
  <div class="field">
    <label class="field__label" for="transaction_payee">Payee</label>
    <input class="field__input" id="transaction_payee" name="transaction[payee]" value="<%= @form[:payee] %>" maxlength="200" autocomplete="off">
  </div>
  <div class="field">
    <label class="field__label" for="transaction_category_id">Category</label>
    <select class="field__input" id="transaction_category_id" name="transaction[category_id]">
      <option value="">No category</option>
      <% category_options.each do |category| %>
        <option value="<%= category.public_id %>"<%= " selected" if category.public_id == @form[:category_id] %>><%= category.name %></option>
      <% end %>
    </select>
  </div>
  <div class="field">
    <label class="field__label" for="transaction_memo">Memo</label>
    <input class="field__input" id="transaction_memo" name="transaction[memo]" value="<%= @form[:memo] %>" autocomplete="off">
  </div>
  <% { outflow: "Outflow", inflow: "Inflow" }.each do |key, label| %>
    <% err = @field_errors[key] %>
    <div class="field<%= ' field--invalid' if err %>" data-controller="field" data-field-kind-value="currency" data-field-defer-value="true">
      <label class="field__label" for="transaction_<%= key %>"><%= label %></label>
      <input class="field__input field__input--money" id="transaction_<%= key %>" name="transaction[<%= key %>]" value="<%= @form[key] %>" inputmode="decimal" autocomplete="off" aria-describedby="transaction_<%= key %>-err"<%= raw(' aria-invalid="true"') if err %> data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing">
      <span class="field__error" id="transaction_<%= key %>-err" data-field-target="error" role="alert"<%= ' hidden' unless err %>><%= err %></span>
      <span class="field__status data-table__sr" data-field-target="status" aria-live="polite"></span>
    </div>
  <% end %>
  <div class="plan-settings__actions">
    <button type="submit" class="btn btn--primary" data-form-target="submit">Save</button>
    <% unless transaction %><button type="submit" class="btn btn--secondary" name="commit_action" value="another" data-form-target="submit">Save and add another</button><% end %>
    <%= link_to "Cancel", users_budget_account_transactions_path(@budget.public_id, @account.public_id), class: "btn btn--secondary" %>
  </div>
<% end %>
