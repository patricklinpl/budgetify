<% content_for :title, "Edit category" %>
<% content_for :shell_header do %>
  <div class="shell-header"><div class="shell-header-row"><div class="shell-header-title">
    <p class="shell-eyebrow">Edit category<%= " (hidden)" if @category.hidden %></p>
    <h1 class="app-shell-page-title"><%= @category.name %></h1>
  </div></div></div>
<% end %>

<section class="plan-settings">
  <% if @errors.any? %>
    <div class="plan-settings__errors" role="alert" tabindex="-1" data-controller="focus">
      <p>The category was not changed.</p>
      <ul><% @errors.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with url: users_budget_category_path(@budget.public_id, @category.public_id), method: :patch, scope: :category, class: "plan-settings__form" do %>
    <div class="field">
      <label class="field__label" for="category_name">Category name</label>
      <input class="field__input" id="category_name" name="category[name]" value="<%= @name %>" required maxlength="<%= PlanLifecycle::MAX_NAME_LENGTH %>">
    </div>
    <div class="field">
      <label class="field__label" for="category_hidden">Visibility</label>
      <select class="field__input" id="category_hidden" name="category[hidden]">
        <option value="false" <%= "selected" unless @category.hidden %>>Shown in the budget</option>
        <option value="true" <%= "selected" if @category.hidden %>>Hidden</option>
      </select>
    </div>
    <div class="plan-settings__actions">
      <button type="submit" class="btn btn--primary">Save category</button>
      <%= link_to "Cancel", users_budget_path(@budget.public_id), class: "btn btn--secondary" %>
    </div>
  <% end %>

  <section class="plan-settings__fresh">
    <h2>Delete category</h2>
    <p>
      This category has <%= pluralize(@impact[:transactions] + @impact[:split_lines], "transaction line") %>,
      <%= pluralize(@impact[:scheduled_transactions], "scheduled item") %>,
      <%= pluralize(@impact[:money_movements], "money movement") %> and
      <%= number_to_currency(@impact[:assigned] / 1000.0) %> assigned in total.
    </p>
    <% if @impact[:targets].positive? %>
      <p>It has a target. Target behavior on delete is not established, so deleting is refused until the target is removed.</p>
    <% end %>
    <%= form_with url: users_budget_category_path(@budget.public_id, @category.public_id), method: :delete, class: "plan-settings__form" do %>
      <div class="field">
        <label class="field__label" for="replacement_id">Move transactions, scheduled items, assigned money and available balance to</label>
        <select class="field__input" id="replacement_id" name="replacement_id">
          <option value="">No replacement</option>
          <% @replacements.each do |replacement| %>
            <option value="<%= replacement.public_id %>"><%= replacement.category_group.name %>: <%= replacement.name %></option>
          <% end %>
        </select>
      </div>
      <div class="field">
        <label><input type="checkbox" name="return_assigned" value="1"> Return assigned money to Ready to Assign (only when there is no replacement and no history)</label>
      </div>
      <button type="submit" class="btn btn--destructive">Delete category</button>
    <% end %>
  </section>
</section>
