<% content_for :title, "Monthly target" %>
<% fmt = @budget.currency_format %>
<% content_for :shell_header do %>
  <div class="shell-header"><div class="shell-header-row"><div class="shell-header-title">
    <p class="shell-eyebrow">Monthly target</p>
    <h1 class="app-shell-page-title"><%= @category.name %></h1>
  </div></div></div>
<% end %>

<section class="plan-settings target-page">
  <% if notice %><p class="plan-settings__notice" role="status"><%= notice %></p><% end %>
  <% if @target_error %>
    <div class="plan-settings__errors" role="alert" tabindex="-1" data-controller="focus"><p><%= @target_error %></p></div>
  <% end %>
  <% monthly = MonthlyTarget.monthly?(@category) %>
  <% if MonthlyTarget.any?(@category) && !monthly %>
    <p>This category has a target that this editor does not support yet (not a plain monthly amount). It is shown only, and can be removed below. Replacing it is not built.</p>
  <% elsif monthly %>
    <p>Target: <%= money_with_exact(fmt, @category.goal_target) %> every month. <%= @month.strftime("%B %Y") %>: assigned <%= money_with_exact(fmt, @assigned) %>,
      <% if @remaining.positive? %>remaining <%= money_with_exact(fmt, @remaining) %>.<% else %>nothing remaining.<% end %></p>
    <% if @remaining.positive? %>
      <%= form_with url: target_assign_users_budget_category_path(@budget.public_id, @category.public_id), method: :post, class: "plan-settings__form" do %>
        <input type="hidden" name="expected_remaining" value="<%= @remaining %>">
        <button type="submit" class="btn btn--primary">Assign remaining <%= money_with_exact(fmt, @remaining) %></button>
      <% end %>
    <% end %>
  <% else %>
    <p>This category has no target.</p>
  <% end %>

  <% unless MonthlyTarget.any?(@category) && !monthly %>
    <%= form_with url: target_update_users_budget_category_path(@budget.public_id, @category.public_id), method: :patch, scope: :target, class: "plan-settings__form",
          data: { controller: "form submit", action: "input->form#update field:commit->form#update field:invalid->form#update field:cancel->form#update field:restored->form#update field:commit->submit#submit turbo:submit-end->submit#end" } do %>
      <div class="field<%= ' field--invalid' if @field_error %>" data-controller="field" data-field-kind-value="currency" data-field-defer-value="true">
        <label class="field__label" for="target_amount">Set aside every month</label>
        <input class="field__input field__input--money" id="target_amount" name="target[amount]" value="<%= @amount_text %>" inputmode="decimal" autocomplete="off" required aria-describedby="target_amount-err"<%= raw(' aria-invalid="true" autofocus') if @field_error %> data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing">
        <span class="field__error" id="target_amount-err" data-field-target="error" role="alert"<%= ' hidden' unless @field_error %>><%= @field_error %></span>
        <span class="field__status data-table__sr" data-field-target="status" aria-live="polite"></span>
      </div>
      <div class="plan-settings__actions">
        <button type="submit" class="btn btn--primary" data-form-target="submit"><%= monthly ? "Save target" : "Create target" %></button>
        <%= link_to "Back to the plan", users_budget_path(@budget.public_id), class: "btn btn--secondary" %>
      </div>
    <% end %>
  <% else %>
    <p><%= link_to "Back to the plan", users_budget_path(@budget.public_id), class: "budget-back-link" %></p>
  <% end %>

  <% if MonthlyTarget.any?(@category) %>
    <section class="plan-settings__fresh">
      <h2>Remove target</h2>
      <p>Removing the target does not change Assigned or Available. Undo does not cover target changes yet.</p>
      <%= form_with url: target_destroy_users_budget_category_path(@budget.public_id, @category.public_id), method: :delete do %>
        <button type="submit" class="btn btn--destructive">Remove target</button>
      <% end %>
    </section>
  <% end %>
</section>
