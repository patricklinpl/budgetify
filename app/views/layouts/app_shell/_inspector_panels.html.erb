<%# Inspector panel shells (LAY-05): Summary and Auto-Assign. Styling and
    structure only; values and actions are wired by the plan feature issues. %>
<section class="shell-panel" aria-labelledby="shell-summary-title">
  <h2 id="shell-summary-title" class="shell-panel-title"><%= Date.current.strftime("%B") %>'s Summary</h2>
  <dl class="shell-panel-list">
    <% summary = @plan_summary %>
    <% [["Left Over from Last Month", :left_over], ["Assigned in #{Date.current.strftime('%B')}", :assigned], ["Activity", :activity], ["Available", :available]].each do |row, key| %>
      <div class="shell-panel-row">
        <dt><%= row %></dt>
        <% if summary %>
          <dd class="<%= shell_money_class(summary[key]) %>"><%= shell_money(summary[key]) %></dd>
        <% else %>
          <dd class="money">&mdash;</dd>
        <% end %>
      </div>
    <% end %>
  </dl>
</section>
<section class="shell-panel" aria-labelledby="shell-cost-title">
  <h2 id="shell-cost-title" class="shell-panel-title">Cost to Be Me</h2>
  <dl class="shell-panel-list">
    <div class="shell-panel-row">
      <dt><%= Date.current.strftime("%B") %>&rsquo;s Targets</dt>
      <% if @plan_summary %>
        <dd class="money"><%= shell_money(@plan_summary[:targets]) %></dd>
      <% else %>
        <dd class="money">&mdash;</dd>
      <% end %>
    </div>
  </dl>
  <button type="button" class="shell-button" disabled title="Expected income is not built yet">Enter your expected income</button>
</section>
<section class="shell-panel" aria-labelledby="shell-auto-title">
  <h2 id="shell-auto-title" class="shell-panel-title">Auto-Assign</h2>
  <ul class="shell-panel-list">
    <% [["Underfunded", nil], ["Assigned Last Month", :assigned_last_month], ["Spent Last Month", :spent_last_month], ["Assigned in Future Months", :assigned_future], ["Reset Available Amounts", nil], ["Reset Assigned Amounts", nil]].each do |row, key| %>
      <li class="shell-panel-row"><span><%= row %></span>
        <% if key && @plan_summary %><span class="money"><%= shell_money(@plan_summary[key]) %></span><% else %><span class="money">&mdash;</span><% end %>
      </li>
    <% end %>
  </ul>
</section>
