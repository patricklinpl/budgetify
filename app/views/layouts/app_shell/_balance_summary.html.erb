<%# Cleared + Uncleared = Working balance line, shared by the plan-page register header and the register page. Expects local `account`; `details: false` leaves out the disabled details button. %>
<%# Show the cleared and uncleared parts only when they add up to the stored
    balance; otherwise show dashes rather than a misleading equation. %>
<% consistent = account.cleared_balance + account.uncleared_balance == account.balance %>
<p class="shell-balance-summary" aria-label="Balance summary">
  <span class="shell-balance"><span class="shell-balance-label">Cleared</span> <% if consistent %><span class="<%= shell_money_class(account.cleared_balance) %>"><%= shell_money(account.cleared_balance) %></span><% else %><span class="money">&mdash;</span><% end %></span>
  <span aria-hidden="true">+</span>
  <span class="shell-balance"><span class="shell-balance-label">Uncleared</span> <% if consistent %><span class="<%= shell_money_class(account.uncleared_balance) %>"><%= shell_money(account.uncleared_balance) %></span><% else %><span class="money">&mdash;</span><% end %></span>
  <span aria-hidden="true">=</span>
  <span class="shell-balance"><span class="shell-balance-label">Working</span> <span class="<%= shell_money_class(account.balance) %>"><%= shell_money(account.balance) %></span></span>
  <% if local_assigns.fetch(:details, true) %><button type="button" class="shell-icon-button" disabled aria-label="Balance details"><span aria-hidden="true">i</span></button><% end %>
</p>
