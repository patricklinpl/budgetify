<% content_for :title, "Form primitives" %>

<div class="ui-preview">
  <h1>Form controls and editor primitives</h1>
  <p>Presentation and interaction conventions only (#70). Theme: <%= link_to "light", ui_forms_path %> | <%= link_to "dark", ui_forms_path(theme: "dark") %></p>
  <p class="form-affordances">Editor convention: Enter commits, Escape cancels and restores the previous value, leaving the field commits with the same checks. Invalid input keeps your text and shows an error.</p>

  <form data-controller="form" data-action="input->form#update field:commit->form#update field:invalid->form#update field:cancel->form#update field:restored->form#update" onsubmit="return false">
    <h2>Text input: default, disabled, error</h2>
    <div class="field" data-controller="field" data-field-kind-value="text">
      <label class="field__label" for="f-name">Account name</label>
      <input class="field__input" id="f-name" aria-describedby="f-name-err" data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing" value="Checking" required>
      <span class="field__error" id="f-name-err" data-field-target="error" role="alert" hidden></span>
      <span class="field__status" data-field-target="status" aria-live="polite"></span>
    </div>
    <div class="field">
      <label class="field__label" for="f-dis">Disabled</label>
      <input class="field__input" id="f-dis" value="Cannot edit" disabled>
    </div>
    <div class="field field--invalid" data-static>
      <label class="field__label" for="f-err">Error state (static)</label>
      <input class="field__input" id="f-err" value="" aria-invalid="true">
      <span class="field__error">This field is required</span>
    </div>

    <h2>Currency input (expressions)</h2>
    <div class="field" data-controller="field" data-field-kind-value="currency">
      <label class="field__label" for="f-money">Assigned</label>
      <input class="field__input field__input--money" id="f-money" data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing" value="$100.00" inputmode="decimal" aria-describedby="money-hint money-err">
      <span class="field__hint" id="money-hint">Try 10+5*2 (commits $20.00). Invalid text like abc is rejected and kept.</span>
      <span class="field__error" id="money-err" data-field-target="error" role="alert" hidden></span>
      <span class="field__status" data-field-target="status" aria-live="polite"></span>
    </div>

    <h2>Date field with picker</h2>
    <div class="field" data-controller="field" data-field-kind-value="date">
      <label class="field__label" for="f-date">Date</label>
      <input class="field__input" id="f-date" aria-describedby="date-err" data-field-target="input" data-action="keydown->field#keydown blur->field#blur input->field#typing" value="11/23/2026" placeholder="MM/DD/YYYY">
      <span class="field__error" id="date-err" data-field-target="error" role="alert" hidden></span>
      <span class="field__status" data-field-target="status" aria-live="polite"></span>
      <div class="date-picker" role="group" aria-label="Pick a date, November 2026">
        <div class="date-picker__head">November 2026</div>
        <% (1..30).each do |d| %>
          <button type="button" class="date-picker__day" data-date="2026-11-<%= format("%02d", d) %>" aria-label="November <%= d %>, 2026" data-action="field#pick"><%= d %></button>
        <% end %>
      </div>
    </div>

    <h2>Autocomplete (hidden payees are not suggested)</h2>
    <div class="field field--autocomplete" data-controller="autocomplete">
      <label class="field__label" for="f-payee">Payee</label>
      <input class="field__input" id="f-payee" role="combobox" aria-controls="payee-list" aria-expanded="false" aria-autocomplete="list" autocomplete="off" data-autocomplete-target="input" data-action="input->autocomplete#filter keydown->autocomplete#keydown">
      <ul class="autocomplete__list" id="payee-list" role="listbox" data-autocomplete-target="list" data-action="click->autocomplete#click">
        <% @payees.each_with_index do |name, i| %>
          <% hidden = name.include?("(hidden)") %>
          <li id="payee-opt-<%= i %>" role="option" aria-selected="false" data-hidden="<%= hidden %>"><%= name.sub(" (hidden)", "") %></li>
        <% end %>
      </ul>
      <span class="field__hint">Old Gym is a hidden payee: it never appears here.</span>
    </div>

    <h2>Checkbox and radio group</h2>
    <label class="choice"><input type="checkbox" checked><span>Cleared</span></label>
    <label class="choice"><input type="checkbox"><span>Flagged</span></label>
    <label class="choice"><input type="checkbox" disabled><span>Disabled option</span></label>
    <fieldset class="field">
      <legend class="field__label">Repeat</legend>
      <label class="choice"><input type="radio" name="repeat" checked><span>Never</span></label>
      <label class="choice"><input type="radio" name="repeat"><span>Monthly</span></label>
    </fieldset>

    <h2>Buttons (submit disabled while a required field is empty or invalid)</h2>
    <div class="form-actions">
      <button type="submit" class="btn btn--primary" data-form-target="submit">Save</button>
      <button type="button" class="btn btn--secondary">Cancel</button>
      <button type="button" class="btn btn--destructive">Delete</button>
      <button type="button" class="btn btn--primary" disabled>Disabled</button>
    </div>
  </form>
</div>
